<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="projektPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- az entitások -->
        <class>hu.unideb.inf.models.UserModel</class>
        <class>hu.unideb.inf.models.CardModel</class>
        <class>hu.unideb.inf.models.TripModel</class>

        <properties>
            <!-- kapcsolat -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/adatbazis_neve"/>
            <property name="jakarta.persistence.jdbc.user" value="felhasznalo"/>
            <property name="jakarta.persistence.jdbc.password" value="jelszo"/>

            <!-- a társad sémáját ne módosítsa -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- fejlesztéshez hasznos -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>